# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/party?retryWrites=true&w=majority

# Secret passcode the door volunteer enters to access the admin check-in screen.
# Make this something you can say out loud but a stranger can't guess.
ADMIN_KEY=change-this-to-something-only-you-know

# Comma-separated list of frontend URLs allowed to call this API.
# Add your deployed frontend URL here once you have it (and keep localhost for local testing).
CLIENT_ORIGINS=http://localhost:5173

PORT=4000
